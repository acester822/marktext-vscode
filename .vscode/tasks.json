{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(ERROR|WARNING): (.+)$",
          "severity": 1,
          "file": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(.*)$",
          "endsPattern": "Done in \\d+ms"
        }
      },
      "group": "none"
    }
  ]
}
