{
  "name": "marktext-vscode",
  "displayName": "MarkText Editor",
  "description": "WYSIWYG Markdown editor for VS Code, powered by MarkText's @muyajs/core (muya) engine.",
  "version": "0.2.2",
  "publisher": "marktext-vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:marktext-editor.open",
    "onCommand:marktext-editor.reloadWebview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "marktext-editor.open",
        "title": "MarkText: Open WYSIWYG Editor"
      },
      {
        "command": "marktext-editor.reloadWebview",
        "title": "MarkText: Reload Webview"
      },
      {
        "command": "marktext-editor.toggleDev",
        "title": "MarkText: Toggle Dev Mode (verbose logging)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marktext-editor.open",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "marktext-editor.open",
          "when": "resourceExtname == .md"
        }
      ]
    }
  },
  "scripts": {
    "vendor:muya": "bash scripts/vendor-muya.sh",
    "build:host": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=out/extension.js --sourcemap",
    "build:web": "esbuild webview/src/muya-styles.css --bundle --loader:.css=css --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.svg=dataurl --loader:.png=dataurl --outfile=out/webview/main.css --define:process.env.NODE_ENV='\"production\"' && esbuild webview/src/main.ts --bundle --format=iife --outfile=out/webview/main.js --sourcemap --alias:@muyajs/core=./vendor/muya/lib/es/index.js --loader:.png=dataurl --loader:.svg=dataurl --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.css=empty --define:process.env.NODE_ENV='\"production\"'",
    "build": "npm run build:host && npm run build:web",
    "watch": "npm run build:host -- --watch=forever & npm run build:web -- --watch=forever & wait",
    "dev": "npm run watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.4.5"
  }
}
