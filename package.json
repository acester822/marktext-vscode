{
  "name": "marktext-vscode",
  "displayName": "MarkText Editor",
  "description": "WYSIWYG Markdown editor for VS Code, powered by MarkText's @muyajs/core (muya) engine.",
  "version": "0.5.5",
  "publisher": "marktext-vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:marktext-vscode.marktextEditor",
    "onCommand:marktext-editor.open",
    "onCommand:marktext-editor.reloadWebview"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "marktext-vscode.marktextEditor",
        "displayName": "MarkText WYSIWYG",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "MarkText Editor",
      "properties": {
        "marktext.editor.defaultForMarkdown": {
          "type": "boolean",
          "default": false,
          "description": "Open .md files in the MarkText WYSIWYG editor by default instead of the built-in Monaco text editor. Toggle this off to always use the classic editor (you can still switch per-file from the editor title bar)."
        }
      }
    },
    "commands": [
      {
        "command": "marktext-editor.open",
        "title": "MarkText: Open WYSIWYG Editor"
      },
      {
        "command": "marktext-editor.reloadWebview",
        "title": "MarkText: Reload Webview"
      },
      {
        "command": "marktext-editor.toggleDev",
        "title": "MarkText: Toggle Dev Mode (verbose logging)"
      },
      {
        "command": "marktext-editor.useClassic",
        "title": "MarkText: Switch to Classic Editor",
        "icon": "$(edit)"
      },
      {
        "command": "marktext-editor.useWysiwyg",
        "title": "MarkText: Switch to WYSIWYG Editor",
        "icon": "$(markdown)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marktext-editor.useClassic",
          "when": "resourceExtname == .md && marktext.editor.isWysiwyg",
          "group": "navigation"
        },
        {
          "command": "marktext-editor.useWysiwyg",
          "when": "resourceExtname == .md && !marktext.editor.isWysiwyg",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "marktext-editor.open",
          "when": "resourceExtname == .md"
        }
      ]
    }
  },
  "scripts": {
    "vendor:muya": "bash scripts/vendor-muya.sh",
    "build:host": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=out/extension.js --sourcemap",
    "build:web": "esbuild webview/src/muya-styles.css --bundle --loader:.css=css --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.svg=dataurl --loader:.png=dataurl --outfile=out/webview/main.css --define:process.env.NODE_ENV='\"production\"' && esbuild webview/src/main.ts --bundle --format=iife --outfile=out/webview/main.js --sourcemap --alias:@muyajs/core=./vendor/muya/lib/es/index.js --loader:.png=dataurl --loader:.svg=dataurl --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.css=empty --define:process.env.NODE_ENV='\"production\"'",
    "build:editor": "esbuild webview/src/excalidraw-editor.tsx --bundle --format=iife --outfile=out/webview/excalidraw-editor.js --sourcemap --loader:.css=empty --jsx=automatic --define:process.env.NODE_ENV='\"production\"'",
    "build": "npm run build:host && npm run build:web && npm run build:editor",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "npm run build:host -- --watch=forever & npm run build:web -- --watch=forever & npm run build:editor -- --watch=forever & wait",
    "dev": "npm run watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
