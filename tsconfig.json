{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2018", "ES2019", "ES2020", "ES2021", "DOM", "DOM.Iterable", "ES2018.AsyncIterable"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vscode", "node"],
    "paths": {
      "@muyajs/core": ["./vendor/muya/lib/types/index.d.ts"]
    }
  },
  "include": ["src", "webview/src"]
}
